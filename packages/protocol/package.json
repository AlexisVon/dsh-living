  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlexisVon/dsh-living.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/AlexisVon/dsh-living/tree/main/packages/protocol",
