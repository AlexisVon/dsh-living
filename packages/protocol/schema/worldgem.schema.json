{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/AlexisVon/dsh-living/packages/protocol/schema/worldgem.schema.json",
  "title": "WorldGem manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "version"],
  "anyOf": [
    { "required": ["mcp"] },
    { "required": ["event"] },
    { "required": ["skill"] }
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,31}$",
      "description": "小写字母开头，只含 a-z0-9-，长度 2–32"
    },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9a-z.-]+)?$" },
    "description": { "type": "string" },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "env": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "description": "事件通道进程；核心负责拉起并监督",
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "visibility"],
      "properties": {
        "protocol": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "contains": { "const": "ingest" },
          "items": { "enum": ["ingest", "outbox", "ack"] }
        },
        "visibility": {
          "enum": ["private", "public", "group"],
          "description": "public / group 的发声强制过限制层"
        }
      }
    },
    "skill": { "type": "string", "minLength": 1, "description": "SKILL.md 的相对路径" },
    "notify": {
      "type": "object",
      "additionalProperties": false,
      "description": "推送通知策略：ring=收到立即 wake 一轮；silent=只落事件，等下一轮顺带处理",
      "properties": {
        "push": { "$ref": "#/definitions/notifyPolicy" },
        "trusted": { "$ref": "#/definitions/notifyPolicy" }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "limits": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 1 }
    },
    "etiquette": {
      "type": "array",
      "items": { "type": "string" }
    },
    "failure_hints": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "provider_auth",
          "provider_quota",
          "provider_rate",
          "provider_timeout",
          "gem_unavailable",
          "gem_cookie_expired",
          "browser_launch_failed",
          "db_locked",
          "db_corrupt",
          "config_invalid",
          "budget_exhausted",
          "window_closed",
          "interrupted",
          "unknown"
        ]
      },
      "additionalProperties": { "type": "string" }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "description": "宝石声明的配置 UI；核心按字段类型渲染，不执行宝石代码",
      "required": ["fields"],
      "properties": {
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/configField" }
        }
      }
    }
  },
  "definitions": {
    "configField": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "type"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "label": { "type": "string", "minLength": 1 },
        "type": { "enum": ["text", "textarea", "number", "boolean", "select", "list"] },
        "default": {},
        "help": { "type": "string" },
        "placeholder": { "type": "string" },
        "unit": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number", "exclusiveMinimum": 0 },
        "required": { "type": "boolean" },
        "group": { "type": "string" },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 }
            }
          }
        },
        "itemType": { "enum": ["string", "number"] }
      }
    },
    "notifyPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "enum": ["ring", "silent"] },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limit": { "type": "boolean" },
            "count": { "type": "boolean" }
          }
        }
      }
    }
  }
}
