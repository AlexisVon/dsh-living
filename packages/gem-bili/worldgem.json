{
  "id": "bili",
  "name": "B站",
  "version": "0.2.2",
  "description": "B站：搜视频、读字幕与评论、读历史私信、收私信和 @/回复通知；私信与公开评论都发出站审计闸",
  "mcp": {
    "command": "node",
    "args": ["mcp/server.js"],
    "tools": ["bili_search", "bili_video", "bili_user", "bili_owner", "bili_subtitle", "bili_comments", "bili_replies", "bili_dm_sessions", "bili_dm_history", "bili_dynamics"]
  },
  "event": {
    "protocol": ["ingest", "outbox", "ack"],
    "visibility": "public"
  },
  "channel": {
    "command": "node",
    "args": ["channel/run.mjs"]
  },
  "notify": {
    "push": { "mode": "ring", "budget": { "limit": true, "count": true } },
    "trusted": { "mode": "ring", "budget": { "limit": false, "count": false } }
  },
  "skill": "skill/SKILL.md",
  "config": {
    "fields": [
      {
        "key": "dmPollSeconds",
        "label": "私信轮询间隔",
        "type": "number",
        "default": 60,
        "min": 15,
        "max": 600,
        "step": 5,
        "unit": "秒",
        "group": "轮询",
        "help": "两次拉私信的间隔"
      },
      {
        "key": "noticePollSeconds",
        "label": "通知轮询间隔",
        "type": "number",
        "default": 60,
        "min": 30,
        "max": 1800,
        "step": 10,
        "unit": "秒",
        "group": "轮询",
        "help": "拉 @/回复等通知的间隔"
      },
      {
        "key": "outboxPollSeconds",
        "label": "外发轮询间隔",
        "type": "number",
        "default": 5,
        "min": 2,
        "max": 300,
        "step": 1,
        "unit": "秒",
        "group": "轮询",
        "help": "通道多久拉一次待发消息"
      },
      {
        "key": "dmHistorySeconds",
        "label": "启动回看窗口",
        "type": "number",
        "default": 300,
        "min": 0,
        "max": 86400,
        "step": 60,
        "unit": "秒",
        "group": "轮询",
        "help": "启动时回看多久内的私信；0 表示只处理新的"
      },
      {
        "key": "ownerUid",
        "label": "主人 UID",
        "type": "text",
        "default": "",
        "placeholder": "例如 12345678",
        "group": "身份",
        "help": "主人私信免判决；留空则不识别主人"
      },
      {
        "key": "sendPerMinute",
        "label": "外发速率",
        "type": "number",
        "default": 5,
        "min": 1,
        "max": 30,
        "step": 1,
        "unit": "条/分钟",
        "group": "限制",
        "help": "通道实际的滑动窗口上限；超过就等，不硬发"
      },
      {
        "key": "replyCooldownSeconds",
        "label": "同目标冷却",
        "type": "number",
        "default": 60,
        "min": 0,
        "max": 600,
        "step": 10,
        "unit": "秒",
        "group": "限制",
        "help": "向同一个发送目标连续外发的最小间隔"
      },
      {
        "key": "proactiveDaily",
        "label": "主动发送日额度",
        "type": "number",
        "default": 20,
        "min": 0,
        "max": 500,
        "step": 1,
        "unit": "条/天",
        "group": "限制",
        "help": "只计主动发起的私信/评论；回复收到的消息不占额度。0 = 不限"
      }
    ]
  },
  "capabilities": {
    "text": true,
    "image": false,
    "voice": false,
    "group": false
  },
  "limits": {
    "maxChars": 1000,
    "perMinute": 120,
    "sendPerMinute": 5,
    "proactiveDaily": 20
  },
  "etiquette": [
    "私信只回复给你收到消息的人，不要群发",
    "公开评论是公网发言，必须带 visibility=public 过规则表 + 限制层；通过即发，失败会返回原因，不要换目标绕开",
    "回复无关的人会消耗一轮预算；先判断值不值得，再决定发不发",
    "主动发起的私信/评论每天有额度；回复收到的消息不占额度",
    "同一条内容不重复发送；同一目标至少间隔一分钟；失败先说明，不静默连发",
    "历史私信只在需要时用 bili_dm_history 主动读，不要假装记得没读过的内容",
    "没有字幕或没有读到的内容，直接说没有，不要编造"
  ],
  "failure_hints": {
    "gem_cookie_expired": "B站登录态失效，需要重新扫码：在宝石目录运行 node channel/login.mjs",
    "gem_unavailable": "B站宝石不可用，本轮不要声称看过视频或发过私信",
    "config_invalid": "发送目标或内容不合法（例如超过 1000 字），改短或换目标",
    "provider_rate": "B站限流或风控，稍后再试，不要连续重试",
    "provider_quota": "今日主动发送额度已用尽；等明天，或停下不要连续重试",
    "window_closed": "对方当前不接受消息或窗口已关，改天再说",
    "unknown": "B站接口返回未知错误，先停下来说明情况"
  }
}
